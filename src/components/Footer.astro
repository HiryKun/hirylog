---
import { AUTHOR, SITE, SOCIAL } from "../config";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__mark">
      {SITE.title}{SITE.titleMark && <span> {SITE.titleMark}</span>} — {
        SITE.tagline
      }
    </p>

    <ul class="site-footer__social">
      {
        SOCIAL.map((link) => (
          <li>
            <a href={link.href} rel="noopener">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="site-footer__legal">
      <span class="site-footer__legal-item">
        © {year} <a href={AUTHOR.url}>{AUTHOR.name}</a>
      </span>
      <span class="site-footer__legal-item">CC BY 4.0</span>
      <span class="site-footer__legal-item">
        <a
          href="https://beian.miit.gov.cn/"
          target="_blank"
          rel="noopener noreferrer">豫ICP备2026054600号</a
        >
      </span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-y);
    border-top: var(--rule-width) solid var(--color-rule);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    padding-block: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-fg-faint);
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }

  .site-footer__legal {
    margin-left: auto;
  }

  .site-footer__legal-item + .site-footer__legal-item::before {
    content: "·";
    margin-inline: 0.45em;
  }

  @media (max-width: 40rem) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }

    .site-footer__legal {
      margin-left: 0;
      width: 100%;
      letter-spacing: 0.05em;
      line-height: var(--leading-normal);
    }

    .site-footer__legal-item {
      display: block;
    }

    .site-footer__legal-item + .site-footer__legal-item {
      margin-top: var(--space-2);
    }

    .site-footer__legal-item + .site-footer__legal-item::before {
      content: none;
    }
  }
</style>
