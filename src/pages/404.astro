---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="页面未找到"
  description="可能不存在或被移动"
  noindex
>
  <section class="notfound wrap">
    <p class="notfound__code" aria-hidden="true">404 Not Found</p>
    <p class="notfound__mark" aria-hidden="true">Empty.</p>

    <h1 class="notfound__title">你要访问的页面不存在</h1>
    <p class="lede notfound__lede">
      但我们不能因此停下脚步
    </p>

    <p class="notfound__actions label">
      <a href="/">Home</a>
      <span aria-hidden="true">·</span>
      <a href="/blog/">All posts</a>
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 60svh;
    padding-block: var(--space-24);
    text-align: center;
  }

  .notfound__code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .notfound__mark {
    font-family: var(--font-mono);
    margin-top: var(--space-6);
    font-size: clamp(3rem, 12vw, 8rem);
    line-height: 1;
    color: var(--color-fg-faint);
    text-transform: uppercase;
  }

  .notfound__title {
    margin-top: var(--space-8);
    font-size: var(--text-xl);
  }

  .notfound__lede {
    max-width: 32rem;
    margin-top: var(--space-4);
  }

  .notfound__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .notfound__actions a {
    text-decoration: none;
  }

  .notfound__actions a:hover {
    color: var(--color-accent);
  }
</style>
