---
import PixelField from "../components/PixelField.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BLOG, PIXEL, SITE } from "../config";
import { getPublishedPosts } from "../utils/posts";

const posts = (await getPublishedPosts()).slice(0, BLOG.postsOnHome);
---

<BaseLayout overlayHeader>
  <PixelField variant="hero" enabled={PIXEL.hero}>
    <div class="hero">
      <p class="hero__eyebrow">WELCOME MY SITE</p>
      <h1 class="hero__title">一切奇迹的起点</h1>
      <p class="hero__lede">{SITE.tagline}</p>
      <p class="hero__cta">
        <a href="/blog/">Read the blog ↓</a>
      </p>
    </div>

    {
      SITE.titleMark && (
        <p class="hero__rail tategaki" aria-hidden="true">
          MATRIX
        </p>
      )
    }

    {
      PIXEL.hero && (
        <p class="hero__notes" aria-hidden="true">
          <span>MATRIX / WebGL2</span>
          <span class="hero__notes-mid">Scroll ↓</span>
          <span>Move — Light the cells</span>
        </p>
      )
    }
  </PixelField>

  <section class="section wrap">
    <div class="latest__head">
      <h2 class="eyebrow">Latest</h2>
      <a class="latest__all label" href="/blog/">All posts →</a>
    </div>

    <div class="latest__list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  {
    PIXEL.divider && (
      <PixelField
        variant="divider"
        zoom={Number((PIXEL.zoom * 0.7).toFixed(3))}
        radius={PIXEL.radius * 0.55}
      >
        <p class="divider__label label">MATRIX</p>
      </PixelField>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-24) var(--gutter);
    text-align: start;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero__title {
    font-family: var(--font-sans);
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: var(--tracking-hero);
    text-transform: uppercase;
    margin-inline-start: -0.03em;
  }

  .hero__lede {
    max-width: 32rem;
    font-size: var(--text-md);
    letter-spacing: var(--tracking-hero);
    color: var(--color-fg-muted);
  }

  .hero__cta a {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    border: var(--rule-width) solid var(--color-accent);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-accent);
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .hero__cta a:hover {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }

  .hero__rail {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    translate: 0 -50%;
  }

  /* These describe the shader, so they only appear once it has actually
     started — not when it declined for reduced motion or missing WebGL2. The
     element tags itself with data-field-active on boot. */
  .hero__notes {
    display: none;
    position: absolute;
    inset-inline: var(--gutter);
    bottom: var(--space-6);
    justify-content: space-between;
    gap: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-fg-faint);
  }

  :global(.field:has([data-field-active])) .hero__notes {
    display: flex;
  }

  .latest__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: var(--rule-width) solid var(--color-rule);
  }

  .latest__all {
    text-decoration: none;
  }

  .latest__all:hover {
    color: var(--color-accent);
  }

  .latest__list :global(.post-card:last-child) {
    border-bottom: none;
  }

  .divider__label {
    margin: auto;
    text-align: center;
  }

  @media (max-width: 55rem) {
    .hero__rail,
    .hero__notes-mid {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    :global(.field:has([data-field-active])) .hero__notes {
      display: none;
    }
  }
</style>
