---
import "../styles/prose.css";

import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { AUTHOR, SITE, SOCIAL } from "../config";

const colophon = [
  { term: "Framework", value: "Astro 7" },
  { term: "Theme", value: "Sumi" },
  { term: "Type", value: "JetBrains Mono · system sans" },
  { term: "Licence", value: "CC BY 4.0" },
];
---

<BaseLayout title="关于" description={AUTHOR.bio}>
  <div class="wrap">
    <PageHeader eyebrow="Colophon" title="关于" lede={AUTHOR.bio} />

    <div class="about">
      <div class="prose about__body">
        <p>
          因为DIY键盘接触到嵌入式开发，从此一发不可收拾，{SITE.title}正是为了分享开发经验，我相信开放的知识会让世界变得更好。同时，这里也是我探索平面设计风格的试验田。
        </p>

        <p>
          暂时也没什么想说的，日后再补充罢（）
        </p>

        <h2>联系我</h2>

        <ul>
          {
            SOCIAL.map((link) => (
              <li>
                <a href={link.href} rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="about__aside">
        <p class="tategaki about__rail" aria-hidden="true">
          WHERE ALL MIRACLES BEGIN
        </p>

        <dl class="about__colophon">
          {
            colophon.map((row) => (
              <div class="about__row">
                <dt class="label">{row.term}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, var(--width-prose)) 13rem;
    gap: clamp(var(--space-8), 6vw, var(--space-16));
    justify-content: center;
    align-items: start;
    padding-block: var(--space-12);
  }

  .about__aside {
    display: flex;
    gap: var(--space-6);
  }

  .about__rail {
    height: 12rem;
  }

  .about__colophon {
    flex: 1;
    margin: 0;
  }

  .about__row + .about__row {
    margin-top: var(--space-6);
  }

  .about__row dd {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-fg-muted);
  }

  @media (max-width: 60rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .about__aside {
      padding-top: var(--space-8);
      border-top: var(--rule-width) solid var(--color-rule);
    }

    .about__rail {
      display: none;
    }
  }
</style>
